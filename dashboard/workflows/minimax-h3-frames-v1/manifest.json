    "node_count": 41,
    "source": "fs-h3a proven native wiring (J2-J10, artist master TURBO route: SigmaShift 12/3, turbo LoRA 0.8, er_sde/beta/12, int8_convrot video VAE); every optional branch present, absent roles removed structurally by generation/h3_conditioning.py; fs-h3aud: reference audio (LoadAudio 56-58 -> ref_audios), clip soundtracks (GetVideoComponents 53-55 slot 1 -> ref_video_audios) and a frame-0 sound track (LoadAudio 90 -> AddGuide 91 audio), measured in fs-h3audio; fs-obvb: saved as a take pair (mp4 + mctx sidecar) by H3TrimAndSaveVideoWithMCtx, pins unwired (root take), path via PreviewAny"
  },
  "capabilities": {
    "modalities": [
      "keyframes_to_video",
      "image_to_video"
    ],
    "audio": "required_generated",
    "duration": {
      "unit": "seconds",
      "min": 4,
      "max": 15,
      "default": 5,
      "request_type": "integer_seconds",
      "fps": 24,
      "effective_frames": {
        "rule": "round_fps_then_align_modulo",
        "minimum_frames": 5,
        "modulus": 17,
        "remainder": 5
      }
    },
    "aspect_ratios": [
      "21:9 (Ultrawide)",
      "16:9 (Widescreen)",
      "4:3 (Standard)",
      "1:1 (Square)",
      "3:4 (Portrait Standard)",
      "9:16 (Portrait Widescreen)"
    ],
    "megapixel_presets": [
      0.5,
      1.0
    ],
    "canvas_rule": "resolution_selector_multiple_32",
    "media_roles": [
      {
        "id": "keyframes",
        "kind": "keyframes",
        "max": 10,
        "frame_mapping": "first_last_guides",
        "fit": "cover"
      },
      {
        "id": "sound_track",
        "kind": "audio",
        "max": 1,
        "frame": 0,
        "fit": "cut_to_shot"
      }
    ],
    "fit_note": "Stills and clips are cropped to the video frame from the centre.",
    "sound_note": "Sound tracks and music references start at the first frame and are cut to the shot length."
  },
  "defaults": {
    "duration_seconds": 5,
    "aspect_ratio": "16:9 (Widescreen)",
    "megapixels": 0.5,
    "steps": 12,
