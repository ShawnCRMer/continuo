    "comfyui_versions": [
      "0.44.0"
    ],
    "frontend_versions": [
      "1.58.5"
    ],
    "workflow_templates_versions": [
      "0.11.102"
    ],
    "policy": "schema_verified"
  },
  "workflow": {
    "api_file": "workflow-api.json",
    "api_sha256": "47444ecc2521288789c285a9badb9eb5cbce5d6e273994e9037ded9830c082c2",
    "node_count": 12,
    "source": "Native core RelayVSR nodes (Kijai, ComfyUI 2f8943324 comfy_extras/nodes_wan.py: RelayVSRConditioning, VSRDecode), wired as the PR example relayvsr_x2_video.json and research RELAYVSR.md 4.3 A/B, measured by the probe intb/relay/relay_vsr.py on the 5090 (480p x4 -> 1080p 38.5 s, detail 0.5 SSIM 0.949). Frames and audio are cut to IN..OUT (ImageFromBatch / TrimAudioDuration); ImageScale is removed for the model's own size. Lane w23-vsr (VID-153)."
  },
  "capabilities": {
    "modalities": [
      "video_upscale"
    ],
    "audio": "kept_from_source",
    "fps": "source",
    "models": [
      "x2",
      "x4"
    ],
    "sizes": [
      "auto",
      "native",
      "1080p",
      "1440p",
      "2160p",
      "custom"
    ],
    "filters": [
      "lanczos",
      "bicubic",
      "bilinear",
      "area",
      "nearest-exact"
    ],
    "detail": {
      "min": 0.0,
      "max": 1.0,
      "default": 0.5
    },
    "memory": {
      "bytes_per_pixel": 12,
      "rule": "frames x (W*factor) x (H*factor) x 12 <= ram_free - 4 GiB"
    }
  },
  "defaults": {
    "model": "auto",
    "detail": 0.5,
    "size": "auto",
    "filter": "lanczos",
    "seed": 0
